# =====================================================================
# Telegram
# =====================================================================
BOT_TOKEN=replace_me_with_telegram_bot_token

# =====================================================================
# Database (MySQL 8)
# =====================================================================
# Для `alembic upgrade head` достаточно только этого блока (BOT_TOKEN не нужен).
#
# --- Локальная БД в Docker (Mac / разработка) ---
# В корне репо: `docker compose up -d`, дождаться healthy (`docker compose ps`).
# Используйте значения ниже (или скопируйте блок целиком в `.env`):
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_NAME=qclub_dev
#   DB_USER=qclub
#   DB_PASSWORD=qclub_dev
# Если порт 3306 занят на хосте — в docker-compose.yml смените на "3307:3306"
# и выставьте DB_PORT=3307.
#
# --- Beget / прод ---
# На Beget в панели часто Host=localhost — это хост MySQL ТОЛЬКО внутри сервера
# хостинга. С ноутбука с DB_HOST=localhost будет Connection refused: либо
# SSH-туннель (см. README), либо запускай alembic по SSH на сервере.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qclub_dev
DB_USER=qclub
DB_PASSWORD=qclub_dev

# =====================================================================
# Game configuration
# =====================================================================
# Дата начала Дня 1 Тура 1 в зоне МСК (Europe/Moscow), формат YYYY-MM-DD.
# Расписание остальных туров и рассылок считается от этой даты.
GAME_START_DATE_MSK=2026-05-15

# Разрешённые домены email через запятую.
ALLOWED_EMAIL_DOMAINS=pmru.com,contracted.pmru.com

# Доступ только по ссылке t.me/<бот>?start=<токен> (не скрывает бота в поиске Telegram).
# INVITE_ONLY=true
# Один или несколько токенов через запятую (латиница, цифры, _ и -, до 64 символов на токен в ссылке).
# INVITE_START_TOKENS=my_event_2026,backup_token

# =====================================================================
# Admin
# =====================================================================
# Telegram user_id админов через запятую.
ADMIN_IDS=

# =====================================================================
# Logging
# =====================================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# =====================================================================
# Runtime
# =====================================================================
# polling | webhook  (MVP — polling)
RUN_MODE=polling
# Используется только при RUN_MODE=webhook
WEBHOOK_BASE_URL=https://summerperfection.ru
WEBHOOK_PATH=/qclub/webhook
# Опционально: секрет в заголовке X-Telegram-Bot-Api-Secret-Token (латиница, цифры, _, -)
# WEBHOOK_SECRET=replace_with_random_string
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8081
