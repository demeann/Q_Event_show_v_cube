# =====================================================================
# Telegram
# =====================================================================
BOT_TOKEN=replace_me_with_telegram_bot_token

# =====================================================================
# Database (MySQL 8)
# =====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u3412349_default
DB_USER=u3412349_default
DB_PASSWORD=replace_me

# =====================================================================
# Game configuration
# =====================================================================
# Дата начала Дня 1 Тура 1 в зоне МСК (Europe/Moscow), формат YYYY-MM-DD.
# Расписание остальных туров и рассылок считается от этой даты.
GAME_START_DATE_MSK=2026-05-15

# Разрешённые домены email через запятую.
ALLOWED_EMAIL_DOMAINS=pmru.com,contracted.pmru.com

# =====================================================================
# Admin
# =====================================================================
# Telegram user_id админов через запятую.
ADMIN_IDS=

# =====================================================================
# Logging
# =====================================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# =====================================================================
# Runtime
# =====================================================================
# polling | webhook  (MVP — polling)
RUN_MODE=polling
# Используется только при RUN_MODE=webhook
WEBHOOK_BASE_URL=https://summerperfection.ru
WEBHOOK_PATH=/qclub/webhook
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8081
